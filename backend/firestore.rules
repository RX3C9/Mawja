rules_version = '2';
// Mawja Firestore rules. Server-owned fields (tier, status, badges, mawjaId, roles) are written
// only by Cloud Functions through the Admin SDK, which bypasses these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function role() { return signedIn() && request.auth.token.role is string ? request.auth.token.role : ''; }
    function isStaff() { return role() in ['owner', 'admin', 'moderator', 'support']; }
    function notBanned() { return !(signedIn() && request.auth.token.status == 'banned'); }
    // Fields a user may change on their own profile.
    function profileFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['displayName', 'photoUrl', 'locale', 'country', 'bio', 'lastSeenAt', 'privacy']);
    }

    match /users/{uid} {
      allow read: if isSelf(uid) || isStaff();
      allow create: if false; // created by the onUserCreated function
      allow update: if isSelf(uid) && notBanned() && profileFieldsOnly();
      allow delete: if false;

      match /devices/{deviceId} {
        allow read, write: if isSelf(uid) && notBanned();
      }
      match /syncData/{doc} {
        allow read, write: if isSelf(uid) && notBanned()
          && request.auth.token.tier in ['plus', 'pro', 'lifetime', 'family'];
      }
    }

    // Public profile card: Mawja ID, username, badges. Written by functions only.
    match /profiles/{uid} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /usernames/{username} { allow read: if signedIn(); allow write: if false; }
    match /mawjaIds/{id} { allow read: if signedIn(); allow write: if false; }

    match /plans/{planId} { allow read: if true; allow write: if false; }
    match /config/{doc} { allow read: if true; allow write: if false; }
    match /announcements/{id} { allow read: if true; allow write: if false; }

    match /reports/{id} {
      allow create: if signedIn() && notBanned() && request.resource.data.uid == request.auth.uid
        && request.resource.data.message is string && request.resource.data.message.size() < 5000;
      allow read: if isStaff() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if false;
    }

    match /subscriptions/{id} { allow read: if isStaff() || (signedIn() && resource.data.uid == request.auth.uid); allow write: if false; }
    match /payments/{id} { allow read: if isStaff() || (signedIn() && resource.data.uid == request.auth.uid); allow write: if false; }
    match /promoCodes/{code} { allow read, write: if false; }
    match /admins/{uid} { allow read: if isStaff(); allow write: if false; }
    match /auditLog/{id} { allow read: if role() in ['owner', 'admin']; allow write: if false; }
  }
}
