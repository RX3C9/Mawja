rules_version = '2';
// Mawja Firestore rules.
// - Server-owned fields (status, badges, mawjaId, roles) are written only by Cloud Functions or the
//   console, which bypass these rules.
// - Memberships are activated with codes (docs/codes.md) and work on the free Spark plan, without
//   Cloud Functions: the app redeems a code in one client transaction, and these rules only accept
//   a tier change that comes with a valid redemption of an unrevoked, unexpired, not-used-up code.
// - Staff: the `role` custom claim (tools/grantRole.js) or an admins/{uid} doc with a `role` field
//   (can be added by hand in the Firebase console, no billing needed).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function role() { return signedIn() ? request.auth.token.get('role', '') : ''; }
    function adminDoc() { return /databases/$(database)/documents/admins/$(request.auth.uid); }
    function docRoleIn(roles) {
      return signedIn() && exists(adminDoc()) && get(adminDoc()).data.get('role', '') in roles;
    }
    function hasRole(roles) { return role() in roles || docRoleIn(roles); }
    function isStaff() { return hasRole(['owner', 'admin', 'moderator', 'support']); }
    function isAdmin() { return hasRole(['owner', 'admin']); }
    // Generating and revoking membership codes.
    function canManageCodes() { return isAdmin(); }
    function isOwner() { return hasRole(['owner']); }
    function isModerator() { return hasRole(['owner', 'admin', 'moderator']); }
    function tiers() { return ['free', 'plus', 'pro', 'lifetime', 'family']; }
    // ---- Staff writes from the admin apps (Spark plan: no Cloud Functions) -------------------
    // Every staff write carries `auditId`: the id of an auditLog entry written in the same batch
    // (its `at` equals this request's time), by the same person, about the same document.
    function auditPath(id) { return /databases/$(database)/documents/auditLog/$(id); }
    function audited(target) {
      let id = request.resource.data.get('auditId', '');
      return id is string && id.matches('^[A-Za-z0-9_-]{1,64}$')
        && existsAfter(auditPath(id))
        && getAfter(auditPath(id)).data.at == request.time
        && getAfter(auditPath(id)).data.actorUid == request.auth.uid
        && getAfter(auditPath(id)).data.target == target;
    }
    function optString(d, key, max) { return !(key in d) || d[key] == null || (d[key] is string && d[key].size() <= max); }
    function optBool(d, key) { return !(key in d) || d[key] is bool; }
    function optInt(d, key) { return !(key in d) || (d[key] is int && d[key] >= 0); }
    function optTime(d, key) { return !(key in d) || d[key] == null || d[key] is timestamp; }
    function optMap(d, key) { return !(key in d) || (d[key] is map && d[key].size() <= 100); }
    function notBanned() { return !(signedIn() && request.auth.token.get('status', '') == 'banned'); }
    // Fields a user may change on their own profile.
    function profileFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['displayName', 'photoUrl', 'locale', 'country', 'bio', 'lastSeenAt', 'privacy']);
    }

    // ---- Membership codes -------------------------------------------------------------------
    function paidTiers() { return ['plus', 'pro', 'lifetime', 'family']; }
    function rank(tier) { return {'free': 0, 'plus': 1, 'pro': 2, 'family': 3, 'lifetime': 4}[tier]; }
    function isHash(h) { return h is string && h.matches('^[0-9a-f]{64}$'); }
    function codePath(h) { return /databases/$(database)/documents/codes/$(h); }
    function redemptionPath(h) { return /databases/$(database)/documents/redemptions/$(h + '_' + request.auth.uid); }
    function userPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function attemptPath() { return /databases/$(database)/documents/users/$(request.auth.uid)/meta/redeem; }
    // The code doc can still be redeemed.
    function codeOk(c) {
      return c.revoked == false && c.used < c.maxUses
        && (c.expiresAt == null || c.expiresAt > request.time);
    }
    // Redeemed in this very batch: the redemption doc is new.
    function redeemingNow(h) {
      return !exists(redemptionPath(h)) && existsAfter(redemptionPath(h));
    }
    // The user announced this code a moment ago (throttled, see meta/redeem below).
    function recentAttempt(h) {
      return signedIn() && exists(attemptPath())
        && get(attemptPath()).data.hash == h
        && get(attemptPath()).data.lastAttempt > request.time - duration.value(10, 'm');
    }
    function isActive(old) {
      return old.get('tier', 'free') in paidTiers()
        && (old.get('tierUntil', null) == null || old.get('tierUntil', null) > request.time);
    }
    function near(t, target) {
      return t is timestamp
        && t > target - duration.value(10, 'm') && t < target + duration.value(10, 'm');
    }
    // Mirror of app CodeRedeemPolicy.decide (:shared-codes): lifetime sticks; open-ended grants only
    // take a better tier; otherwise days stack on the remaining time and the better tier is kept.
    function tierMath(old, code, nu) {
      let act = isActive(old);
      let cur = act ? old.get('tier', 'free') : 'free';
      let days = duration.value(code.days, 'd');
      return cur != 'lifetime' && (
        code.tier == 'lifetime'
          ? (nu.tier == 'lifetime' && nu.tierUntil == null)
          : ((act && old.get('tierUntil', null) == null)
              ? (rank(cur) < rank(code.tier) && nu.tier == code.tier && near(nu.tierUntil, request.time + days))
              : (nu.tier == (rank(cur) > rank(code.tier) ? cur : code.tier)
                  && near(nu.tierUntil, (act ? old.tierUntil : request.time) + days)))
      );
    }
    function tierKeys() { return ['tier', 'tierUntil', 'tierSource', 'tierCodeHash', 'tierUpdatedAt']; }
    // A users doc write that activates a code. [old] is the doc before ({} when it is new).
    function redeemWrite(old) {
      let nu = request.resource.data;
      let h = nu.tierCodeHash;
      return isHash(h)
        && old.get('status', 'active') == 'active'
        && nu.tierSource == 'code'
        && nu.tierUpdatedAt == request.time
        && redeemingNow(h)
        && tierMath(old, get(codePath(h)).data, nu);
    }

    match /users/{uid} {
      allow read: if isSelf(uid) || isStaff();
      // Normally created by the onUserCreated function; on Spark the first code redemption creates it.
      allow create: if (isSelf(uid) && notBanned()
          && request.resource.data.keys().hasOnly(tierKeys()) && redeemWrite({}))
        || (isSelf(uid) && notBanned() && selfRegister())
        || staffUserWrite(uid, request.resource.data.keys());
      allow update: if (isSelf(uid) && notBanned() && (
          profileFieldsOnly()
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(tierKeys()) && redeemWrite(resource.data))
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email'])
              && request.resource.data.email == request.auth.token.get('email', ''))
        ))
        || staffUserWrite(uid, request.resource.data.diff(resource.data).affectedKeys());
      allow delete: if false;

      match /devices/{deviceId} {
        allow read, write: if isSelf(uid) && notBanned();
        allow read: if isStaff();
      }
      // Cloud sync (docs/cloud-sync.md): one doc per item, users/{uid}/syncData/{c}_{k}, last
      // writer wins on the client clock `m`, tombstones (`del`), server write time `at` for pulls.
      match /syncData/{doc} {
        // Owners can always see and erase what is stored about them, also after the membership
        // ended or a ban ("delete my cloud data", tombstone clean-up). Writing needs a paid tier.
        allow read: if isSelf(uid);
        allow create, update: if isSelf(uid) && notBanned() && syncEntitled(uid)
          && syncItemOk(doc, request.resource.data);
        allow delete: if isSelf(uid);
        // Admin "reset sync data": allowed only in the batch that stamps users/{uid}.syncResetAt
        // (itself an audited staff write).
        allow read: if isAdmin();
        allow delete: if isAdmin()
          && getAfter(/databases/$(database)/documents/users/$(uid)).data.get('syncResetAt', null) == request.time;
      }
      // Code redeem throttle: each attempt names the code hash it is about to read, at least 2 s
      // after the previous one and at most 12 per hour. Reading codes/{hash} needs a fresh attempt.
      match /meta/{doc} {
        allow read: if isSelf(uid);
        allow create, update: if doc == 'redeem' && isSelf(uid) && notBanned() && attemptOk();
        allow delete: if false;
      }
    }
    // ---- Cloud sync ---------------------------------------------------------------------------
    function syncEntitled(uid) {
      return request.auth.token.get('tier', '') in paidTiers()
        || isActive(get(/databases/$(database)/documents/users/$(uid)).data);
    }
    function syncCollections() { return ['subscriptions', 'playlists', 'plitems', 'liked', 'history', 'settings']; }
    function syncItemOk(doc, d) {
      return d.keys().hasOnly(['c', 'k', 'm', 'dev', 'del', 'v', 'at', 'd'])
        && d.keys().hasAll(['c', 'k', 'm', 'dev', 'del', 'v', 'at', 'd'])
        && d.c is string && d.c in syncCollections()
        && d.k is string && d.k.matches('^[A-Za-z0-9_.:-]{1,128}$')
        && doc == d.c + '_' + d.k
        && d.m is int && d.m > 0 && d.m < request.time.toMillis() + 86400000
        && d.dev is string && d.dev.size() >= 1 && d.dev.size() <= 64
        && d.del is bool
        && d.v is int && d.v >= 1 && d.v <= 100
        && d.at == request.time
        && d.d is map
        && (d.del ? d.d.size() == 0 : syncPayloadOk(d.c, d.k, d.d));
    }
    // Payload per collection (docs/cloud-sync.md §2). Optional strings are capped; ids are plain.
    function syncPayloadOk(c, k, p) {
      return (c == 'subscriptions' && syncSubscriptionOk(p))
        || (c == 'playlists' && syncPlaylistOk(p))
        || (c == 'plitems' && syncEntryOk(k, p))
        || (c == 'liked' && syncLikedOk(p))
        || (c == 'history' && syncHistoryOk(p))
        || (c == 'settings' && syncSettingOk(k, p));
    }
    function syncId(p, key, max) { return !(key in p) || (p[key] is string && p[key].size() <= max && p[key].matches('^[A-Za-z0-9_.:-]+$')); }
    function syncSubscriptionOk(p) {
      return p.keys().hasOnly(['n', 'a', 'mu']) && p.keys().hasAll(['n'])
        && p.n is string && p.n.size() <= 300
        && optString(p, 'a', 1000) && optBool(p, 'mu');
    }
    function syncPlaylistOk(p) {
      return p.keys().hasOnly(['t', 'ds', 'mu', 'uc', 'or', 'y', 'ca']) && p.keys().hasAll(['t'])
        && p.t is string && p.t.size() <= 200
        && optString(p, 'ds', 1000) && optBool(p, 'mu') && optBool(p, 'uc')
        && (!('or' in p) || p['or'] in ['local', 'youtube'])
        && syncId(p, 'y', 128) && optInt(p, 'ca');
    }
    // One playlist entry: k == p + '.' + v, o = fractional order key.
    function syncEntryOk(k, p) {
      return p.keys().hasOnly(['p', 'v', 'o', 't', 'ch', 'ci', 'th', 'du', 'mu', 'aa']) && p.keys().hasAll(['p', 'v', 'o'])
        && p.p is string && p.p.matches('^[A-Za-z0-9_:-]{1,100}$')
        && p.v is string && p.v.matches('^[A-Za-z0-9_:-]{1,64}$')
        && k == p.p + '.' + p.v
        && p.o is string && p.o.matches('^[0-9A-Za-z]{0,63}[1-9A-Za-z]$')
        && optString(p, 't', 300) && optString(p, 'ch', 300) && syncId(p, 'ci', 128) && optString(p, 'th', 1000)
        && optInt(p, 'du') && optBool(p, 'mu') && optInt(p, 'aa');
    }
    function syncLikedOk(p) {
      return p.keys().hasOnly(['t', 'ch', 'th', 'mu', 'ci', 'du']) && p.keys().hasAll(['t'])
        && p.t is string && p.t.size() <= 300
        && optString(p, 'ch', 300) && optString(p, 'th', 1000) && optBool(p, 'mu') && syncId(p, 'ci', 128) && optInt(p, 'du');
    }
    function syncHistoryOk(p) {
      return p.keys().hasOnly(['t', 'ch', 'ci', 'th', 'pr', 'du', 'mu', 'sh'])
        && optString(p, 't', 300) && optString(p, 'ch', 300) && syncId(p, 'ci', 128) && optString(p, 'th', 1000)
        && (!('pr' in p) || (p.pr is number && p.pr >= 0 && p.pr <= 1))
        && optInt(p, 'du') && optBool(p, 'mu') && optBool(p, 'sh');
    }
    // Whitelisted settings only (= SettingsSyncMapper.KEYS); never the UI language, paths or tokens.
    function syncSettingKeys() {
      return [
        'autoplay', 'queue_autoplay', 'default_quality_wifi', 'default_quality_cellular', 'playback_speed',
        'sponsorblock_enabled', 'sponsorblock_submit_enabled', 'sponsorblock_action_sponsor', 'sponsorblock_action_intro',
        'sponsorblock_action_outro', 'sponsorblock_action_selfpromo', 'sponsorblock_action_interaction',
        'sponsorblock_action_music_offtopic', 'sponsorblock_action_filler', 'sponsorblock_action_preview',
        'sponsorblock_action_exclusive_access', 'dearrow_enabled', 'dearrow_badge_enabled', 'subtitles_enabled',
        'trending_region', 'hide_watched_videos', 'show_shorts_player_prompt', 'comments_enabled', 'comments_preview_enabled',
        'return_youtube_dislikes', 'background_play', 'video_loop', 'skip_silence', 'stable_volume',
        'subscriptions_show_videos', 'subscriptions_show_shorts', 'subscriptions_show_live', 'default_video_codec',
        'shorts_quality_wifi', 'shorts_quality_cellular', 'music_audio_quality', 'preferred_audio_language',
        'preferred_subtitle_language', 'equalizer'
      ];
    }
    function syncSettingOk(k, p) {
      return k in syncSettingKeys()
        && p.keys().hasOnly(['val']) && p.keys().hasAll(['val'])
        && (p.val is bool || p.val is number || (p.val is string && p.val.size() <= 4000));
    }
    // The app lists the signed-in user in the directory staff search (Spark: no onUserCreated).
    function selfRegister() {
      let d = request.resource.data;
      return d.keys().hasOnly(['email', 'displayName', 'photoUrl', 'locale', 'createdAt', 'lastSeenAt'])
        && d.createdAt == request.time
        && (!('email' in d) || d.email == request.auth.token.get('email', ''))
        && optString(d, 'displayName', 100) && optString(d, 'photoUrl', 500) && optString(d, 'locale', 20);
    }
    // Staff edits of a user (admin apps). [keys] are the fields this write changes.
    function staffUserWrite(uid, keys) {
      let d = request.resource.data;
      return isStaff() && audited('users/' + uid)
        && keys.hasOnly(['status', 'banReason', 'statusUpdatedAt', 'statusBy',
             'tier', 'tierUntil', 'tierSource', 'tierUpdatedAt', 'tierUpdatedBy',
             'badges', 'verified', 'syncResetAt', 'staffNote', 'auditId'])
        && (!keys.hasAny(['status', 'banReason', 'statusUpdatedAt', 'statusBy']) || staffStatusOk(uid, d))
        && (!keys.hasAny(['tier', 'tierUntil', 'tierSource', 'tierUpdatedAt', 'tierUpdatedBy']) || staffTierOk(d))
        && (!keys.hasAny(['badges', 'verified']) || staffBadgesOk(d))
        && (!keys.hasAny(['syncResetAt']) || (isAdmin() && d.syncResetAt == request.time))
        && optString(d, 'staffNote', 1000);
    }
    // Moderators suspend and restore; only owner/admin ban. Nobody changes their own status.
    function staffStatusOk(uid, d) {
      return isModerator() && uid != request.auth.uid
        && d.status in ['active', 'suspended', 'banned']
        && (d.status != 'banned' || isAdmin())
        && d.statusUpdatedAt == request.time && d.statusBy == request.auth.uid
        && optString(d, 'banReason', 500);
    }
    // Manual membership: owner/admin; free and lifetime have no end date.
    function staffTierOk(d) {
      let until = d.get('tierUntil', null);
      return isAdmin() && d.tier in tiers()
        && d.tierSource == 'admin' && d.tierUpdatedAt == request.time && d.tierUpdatedBy == request.auth.uid
        && ((d.tier == 'free' || d.tier == 'lifetime') ? until == null : (until == null || until is timestamp));
    }
    function staffBadgesOk(d) {
      return isModerator()
        && (!('badges' in d) || (d.badges is list && d.badges.size() <= 10
            && d.badges.hasOnly(['verified', 'creator', 'founder', 'pro', 'team', 'staff', 'early'])))
        && optBool(d, 'verified');
    }
    function attemptOk() {
      let d = request.resource.data;
      let prev = resource;
      return d.keys().hasOnly(['hash', 'lastAttempt', 'windowStart', 'count'])
        && isHash(d.hash)
        && d.lastAttempt == request.time
        && d.count is int
        && (prev == null || prev.data.lastAttempt < request.time - duration.value(2, 's'))
        && (
          ((prev == null || prev.data.windowStart < request.time - duration.value(1, 'h'))
              && d.windowStart == request.time && d.count == 1)
          || (prev != null && d.windowStart == prev.data.windowStart
              && d.count == prev.data.count + 1 && d.count <= 12)
        );
    }

    // codes/{sha256}: plaintext codes are never stored. Users can only get a code by its hash (right
    // after a throttled attempt), never list or query.
    match /codes/{codeId} {
      allow get: if isStaff() || recentAttempt(codeId);
      allow list: if isStaff();
      allow create: if canManageCodes() && isHash(codeId) && newCodeOk(request.resource.data);
      allow update: if (canManageCodes() && revokeOnly())
        || (signedIn() && notBanned()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used'])
            && request.resource.data.used == resource.data.used + 1
            && codeOk(resource.data)
            && redeemingNow(codeId));
      allow delete: if false;
    }
    function newCodeOk(d) {
      return d.keys().hasOnly(['tier', 'days', 'maxUses', 'used', 'expiresAt', 'revoked', 'createdBy', 'createdAt', 'batchId', 'note', 'hint'])
        && d.keys().hasAll(['tier', 'days', 'maxUses', 'used', 'expiresAt', 'revoked', 'createdBy', 'createdAt', 'batchId', 'note', 'hint'])
        && d.tier in paidTiers()
        && d.days is int
        && (d.tier == 'lifetime' ? d.days == 0 : (d.days >= 1 && d.days <= 3660))
        && d.maxUses is int && d.maxUses >= 1 && d.maxUses <= 10000
        && d.used == 0 && d.revoked == false
        && d.createdBy == request.auth.uid && d.createdAt == request.time
        && (d.expiresAt == null || (d.expiresAt is timestamp && d.expiresAt > request.time))
        && d.batchId is string && d.batchId.size() > 0 && d.batchId.size() <= 64
        && d.note is string && d.note.size() <= 200
        && d.hint is string && d.hint.size() == 4;
    }
    function revokeOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revoked', 'revokedAt', 'revokedBy'])
        && request.resource.data.revoked == true
        && request.resource.data.revokedBy == request.auth.uid
        && request.resource.data.revokedAt == request.time;
    }

    match /codeBatches/{batchId} {
      allow read: if isStaff();
      allow create: if canManageCodes()
        && request.resource.data.keys().hasOnly(['tier', 'days', 'count', 'maxUses', 'expiresAt', 'note', 'createdBy', 'createdAt', 'revoked'])
        && request.resource.data.tier in paidTiers()
        && request.resource.data.count is int && request.resource.data.count >= 1 && request.resource.data.count <= 500
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.revoked == false;
      allow update: if canManageCodes() && revokeOnly();
      allow delete: if false;
    }

    // redemptions/{codeHash}_{uid}: one per user and code, written in the redeem transaction.
    match /redemptions/{rid} {
      allow get: if isStaff() || (signedIn() && rid.matches('^[0-9a-f]{64}_' + request.auth.uid + '$'));
      allow list: if isStaff() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn() && notBanned() && redemptionOk(rid, request.resource.data);
      allow update, delete: if false;
    }
    function redemptionOk(rid, d) {
      let code = get(codePath(d.codeHash)).data;
      let after = getAfter(userPath()).data;
      return d.keys().hasOnly(['uid', 'codeHash', 'codeTier', 'days', 'tier', 'tierUntil', 'batchId', 'previousTier', 'createdAt'])
        && d.uid == request.auth.uid
        && isHash(d.codeHash)
        && rid == d.codeHash + '_' + request.auth.uid
        && recentAttempt(d.codeHash)
        && codeOk(code)
        && getAfter(codePath(d.codeHash)).data.used == code.used + 1
        && d.codeTier == code.tier && d.days == code.days && d.batchId == code.batchId
        && d.previousTier is string
        && d.createdAt == request.time
        && after.tierCodeHash == d.codeHash && after.tier == d.tier && after.tierUntil == d.tierUntil;
    }

    // Public profile card: Mawja ID, username, badges. Written by functions only.
    match /profiles/{uid} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /usernames/{username} { allow read: if signedIn(); allow write: if false; }
    match /mawjaIds/{id} { allow read: if signedIn(); allow write: if false; }

    match /plans/{planId} { allow read: if true; allow write: if false; }
    // Remote config and feature flags per component; owner/admin edit app, downloader and admin.
    match /config/{doc} {
      allow read: if true;
      allow create, update: if isAdmin() && doc in ['app', 'downloader', 'admin']
        && audited('config/' + doc) && configOk(request.resource.data);
      allow delete: if false;
    }
    // In-app messages: owner/admin create and edit (never delete: switch `active` off).
    match /announcements/{id} {
      allow read: if true;
      allow create: if isAdmin() && audited('announcements/' + id) && announcementOk(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time;
      allow update: if isAdmin() && audited('announcements/' + id) && announcementOk(request.resource.data)
        && request.resource.data.get('createdBy', null) == resource.data.get('createdBy', null)
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null);
      allow delete: if false;
    }

    match /reports/{id} {
      allow create: if signedIn() && notBanned() && request.resource.data.uid == request.auth.uid
        && request.resource.data.message is string && request.resource.data.message.size() < 5000;
      allow read: if isStaff() || (signedIn() && resource.data.uid == request.auth.uid);
      // Inbox handling by any staff role: status, assignee, internal note, reply to the reporter.
      allow update: if isStaff() && audited('reports/' + id)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'assignee', 'note', 'reply', 'updatedAt', 'updatedBy', 'resolvedBy', 'auditId'])
        && request.resource.data.get('status', 'open') in ['open', 'in_progress', 'resolved', 'dismissed']
        && request.resource.data.updatedAt == request.time && request.resource.data.updatedBy == request.auth.uid
        && optString(request.resource.data, 'assignee', 128) && optString(request.resource.data, 'note', 2000)
        && optString(request.resource.data, 'reply', 2000);
      allow delete: if false;
    }

    match /subscriptions/{id} { allow read: if isStaff() || (signedIn() && resource.data.uid == request.auth.uid); allow write: if false; }
    match /payments/{id} { allow read: if isStaff() || (signedIn() && resource.data.uid == request.auth.uid); allow write: if false; }
    match /promoCodes/{code} { allow read, write: if false; }
    // Staff roles. The owner adds and changes admin/moderator/support (never owner, never
    // themselves, never another owner); "removed" switches a role off. Owners are made in the
    // console only.
    match /admins/{uid} {
      allow read: if isStaff() || isSelf(uid);
      allow create, update: if isOwner() && uid != request.auth.uid
        && (resource == null || resource.data.get('role', '') != 'owner')
        && audited('admins/' + uid)
        && request.resource.data.keys().hasOnly(['role', 'email', 'note', 'updatedAt', 'updatedBy', 'auditId'])
        && request.resource.data.role in ['admin', 'moderator', 'support', 'removed']
        && request.resource.data.updatedAt == request.time && request.resource.data.updatedBy == request.auth.uid
        && optString(request.resource.data, 'email', 200) && optString(request.resource.data, 'note', 500);
      allow delete: if false;
    }
    // Functions write most entries; staff clients add one for each of their own writes.
    match /auditLog/{id} {
      allow read: if isAdmin();
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(['action', 'actorUid', 'target', 'details', 'at', 'source'])
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.action is string
        && request.resource.data.action.matches('^(code|user|report|announcement|config|staff)[.][a-z_.]+$')
        && request.resource.data.target is string && request.resource.data.target.size() <= 200
        && (!('details' in request.resource.data) || request.resource.data.details is map);
      allow update, delete: if false;
    }
    // Only known keys may change (older docs may carry other keys, which stay as they are).
    function configOk(d) {
      return d.diff(resource == null ? {} : resource.data).affectedKeys().hasOnly(['killSwitch', 'maintenance', 'maintenanceMessage', 'maintenanceMessageAr',
             'minVersion', 'latestVersion', 'updateUrl', 'features', 'tierGates', 'checkoutUrl',
             'updatedAt', 'updatedBy', 'auditId'])
        && d.updatedAt == request.time && d.updatedBy == request.auth.uid
        && optBool(d, 'killSwitch') && optBool(d, 'maintenance')
        && optString(d, 'maintenanceMessage', 500) && optString(d, 'maintenanceMessageAr', 500)
        && optInt(d, 'minVersion') && optInt(d, 'latestVersion')
        && optString(d, 'updateUrl', 500) && optString(d, 'checkoutUrl', 500)
        && optMap(d, 'features') && optMap(d, 'tierGates');
    }
    function announcementOk(d) {
      return d.keys().hasOnly(['title', 'body', 'targetTier', 'locale', 'kind', 'ctaLabel', 'ctaUrl', 'active',
             'startAt', 'endAt', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt', 'auditId'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && d.body is string && d.body.size() > 0 && d.body.size() <= 2000
        && (d.get('targetTier', null) == null || d.targetTier in tiers())
        && (d.get('locale', null) == null || d.locale in ['ar', 'en'])
        && d.get('kind', 'banner') in ['banner', 'dialog', 'news']
        && optString(d, 'ctaLabel', 40) && optString(d, 'ctaUrl', 500)
        && d.active is bool && d.startAt is timestamp && optTime(d, 'endAt')
        && d.updatedBy == request.auth.uid && d.updatedAt == request.time;
    }
  }
}
