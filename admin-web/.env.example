# Mawja Admin web: Firebase web app config (Firebase console -> Project settings -> Your apps -> Web).
# Only public client config goes here; access is enforced by Firestore rules + staff custom claims.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=mawja-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=mawja-app
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_FUNCTIONS_REGION=europe-west1
# Set when hosting under a sub-path, e.g. GitHub Pages: /Mawja/admin
NEXT_PUBLIC_BASE_PATH=
